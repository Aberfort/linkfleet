APP_NAME=LinkFleet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs zero setup for local dev - see backend/README.md for the
# exact steps. Switch to mysql (matching docker-compose.yml / Railway) by
# uncommenting the block below.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=linkfleet
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# See app/Http/Controllers/ConfigController.php - lets a public demo
# deployment disable self-registration without touching the frontend.
REGISTRATION_ENABLED=true

# Custom domains. The target is what customers point their DNS at; leave
# it empty to use this app's own host (APP_URL). DEMO_DOMAIN is optional -
# see the "Custom domains" section of the README before setting it.
CUSTOM_DOMAIN_CNAME_TARGET=
DEMO_DOMAIN=
DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
